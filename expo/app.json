{
  "expo": {
    "name": "Smart AI Assistant",
    "slug": "smart-ai-assistant-slxh0fb",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rork-app",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#09090B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.rork.smart-ai-assistant-slxh0fb",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow Smart AI Assistant to capture voice input for speech-to-text."
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://rork.com/"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": "https://rork.com/"
      },
      "eas": {
        "projectId": "fbf2d612-8c64-4b4c-9866-76c27abb4a0a"
      }
    },
    "android": {
      "newArchEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "app.rork.smartaiassistantslxh0fb"
    }
  }
}
